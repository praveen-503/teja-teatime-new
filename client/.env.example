VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5001# Client Environment Variables
# Copy to .env and fill values

# Backend API URL (leave empty to use Vite proxy in dev)
VITE_API_URL=

# Socket.IO URL (leave empty to use Vite proxy in dev)
VITE_SOCKET_URL=

# For production (Render/Railway backend URL):
# VITE_API_URL=https://your-backend.onrender.com/api
# VITE_SOCKET_URL=https://your-backend.onrender.com
