# Environment Variables — Server
# Copy this file to .env and fill in your values

# Server
PORT=5001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL via Supabase)
# Get these from Supabase Project Settings > Database > Connection string
# Use "Connection pooling" mode for DATABASE_URL and "Session" mode for DIRECT_URL
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgres://postgres.[project-ref]:[password]@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require&supa=base-pooler.x"
